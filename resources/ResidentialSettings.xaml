<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RESIDENTIALTOOLS | Deck Designer" Width="790" Height="760"
        MinWidth="720" MinHeight="560" WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock x:Name="MainHeading" Text="Deck Designer" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock x:Name="FootprintSummary" TextWrapping="Wrap" Margin="0,6,0,0"/>
      <TextBlock Text="Set the deck footprint, choose boards/framing/clips below, preview counts, then build or rebuild the managed layout." TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>
    <TabControl x:Name="Tabs" Grid.Row="1">
      <TabItem Header="1. Decking">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14">
            <TextBlock Text="Layout name"/><TextBox x:Name="LayoutName" Margin="0,3,0,9"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,12,0"><TextBlock Text="Footprint extent A (feet)"/><TextBox x:Name="RunFt" Margin="0,3,0,9"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="Footprint extent B (feet)"/><TextBox x:Name="SpanFt" Margin="0,3,0,9"/></StackPanel>
            </Grid>
            <TextBlock Text="Level"/><ComboBox x:Name="LevelChoice" Margin="0,3,0,9"/>
            <TextBlock Text="Board underside / framing solid top above Level (inches)"/><TextBox x:Name="HeightIn" Margin="0,3,0,9"/>
            <StackPanel x:Name="RoofClearancePanel"><TextBlock Text="Roof deck: framing clearance above source peak (inches)"/><TextBox x:Name="RoofClearance" Margin="0,3,0,9"/></StackPanel>
            <TextBlock Text="Field-board reference direction (A/B; joists initially perpendicular)"/><ComboBox x:Name="BoardAxis" Margin="0,3,0,9"/>
            <TextBlock Text="Additional decking angle from that edge (degrees; 0 follows the edge)"/><TextBox x:Name="BoardAngle" Margin="0,3,0,9"/>
            <CheckBox x:Name="RotateJoists" Content="Rotate joists with decking angle (otherwise keep framing along footprint edges)" Margin="0,4,0,9"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,12,0"><TextBlock Text="Board width (inches; maximum 5.5)"/><TextBox x:Name="BoardWidth" Margin="0,3,0,9"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="Board thickness (inches)"/><TextBox x:Name="BoardThickness" Margin="0,3,0,9"/></StackPanel>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,12,0"><TextBlock Text="Side gap (inches; 0.1875 = 3/16)"/><TextBox x:Name="GapIn" Margin="0,3,0,9"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="Butt / miter gap (inches)"/><TextBox x:Name="ButtGapIn" Margin="0,3,0,9"/></StackPanel>
            </Grid>
            <TextBlock Text="Field-board layout across deck"/><ComboBox x:Name="BoardRowLayout" Margin="0,3,0,8"/>
            <TextBlock Text="Start/end follow the low/high side of the board-row direction in the preview. Keep the full board at the visible edge; the opposite edge takes the rip. Angled outline intersections still trim board ends." TextWrapping="Wrap" Foreground="#555555" Margin="0,0,0,9"/>
            <TextBlock Text="Stock length (feet)"/><ComboBox x:Name="StockLength" Margin="0,3,0,9"/>
            <CheckBox x:Name="PictureFrame" Content="Square-edge picture frame with mitered corners" Click="options_changed" Margin="0,4"/>
            <TextBlock Text="Picture-frame courses"/><ComboBox x:Name="BorderCourses" Margin="0,3,0,9"/>
            <CheckBox x:Name="Stagger" Content="Prefer staggered field joints; add paired joist supports at seams" Margin="0,4"/>
            <CheckBox x:Name="SeamBorder" Content="Add cross-deck breaker boards with coordinated backing" Click="options_changed" Margin="0,4"/>
            <TextBlock Text="Breaker centers (feet along framing layout's board axis; comma separated; blank = automatic stock splits)" TextWrapping="Wrap"/>
            <TextBox x:Name="BreakerPositions" Margin="0,3,0,9" ToolTip="Example: 10 or 10,20. Measured from the framing footprint origin shown in the preview, along the selected A/B direction. With fixed framing, breakers stay along its joists while decking rotates."/>
            <TextBlock Text="Breakers trim to the actual outline, including stepped returns. Enter a center to add one even when the deck is shorter than stock. Long breakers split to stock and get cross-block backing. Square-edge breaker fastening is separate from hidden clip counts." TextWrapping="Wrap" Foreground="#555555" Margin="0,3,0,8"/>
            <TextBlock Text="Countable boards fit horizontal straight-edge Floor outlines, including stepped returns. Long border sides split to stock length; two courses can stagger splits. Openings and curved/sloped surfaces need separate handling. On stepped outlines, beam setbacks use the common joist bearing span. Re-pick the source Floor to refresh the outline." TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#555555"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="2. Framing">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14">
            <TextBlock Text="On-center spacing (inches)"/><ComboBox x:Name="Spacing" Margin="0,3,0,12"/>
            <TextBlock Text="Framing category"/><ComboBox x:Name="Exposure" Margin="0,3,0,12"/>
            <TextBlock Text="Loaded Structural Framing family and type"/><ComboBox x:Name="JoistType" SelectionChanged="joist_changed" Margin="0,3,0,12"/>
            <Button Content="Find loaded joist type..." Click="find_joist" HorizontalAlignment="Left" Padding="10,5" Margin="0,0,0,8"/>
            <TextBlock x:Name="JoistIdentity" TextWrapping="Wrap" Foreground="#8A3E17" Margin="0,0,0,10"/>
            <TextBlock Text="Generate and test Lumber Library RFAs, then load them with Revit Insert &gt; Load Family. All loaded framing types are offered; LL/FT metadata identifies untreated and treated categories." TextWrapping="Wrap" Margin="0,0,0,12"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,12,0"><TextBlock Text="Actual member width (inches)"/><TextBox x:Name="JoistWidth" TextChanged="joist_dimensions_changed" Margin="0,3,0,9"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="Actual member depth (inches)"/><TextBox x:Name="JoistDepth" TextChanged="joist_dimensions_changed" Margin="0,3,0,9"/></StackPanel>
            </Grid>
            <CheckBox x:Name="Rims" Content="Add end rim joists" Margin="0,5"/>
            <CheckBox x:Name="DoubleBorderJoists" Content="Touching double joists at picture-frame field edges" Margin="0,5"/>
            <CheckBox x:Name="Blocking" Content="Add solid blocking rows" Click="options_changed" Margin="0,5"/>
            <TextBlock Text="Maximum span between rows (feet; one centered row when the span is shorter)"/><TextBox x:Name="BlockingSpacing" Margin="0,3,0,9"/>
            <CheckBox x:Name="FollowJoistType" Content="Use joist type and dimensions for blocking / seam backing" Click="follow_block_changed" Margin="0,4,0,8"/>
            <TextBlock Text="Loaded Structural Framing family/type for blocking"/><ComboBox x:Name="BlockingType" SelectionChanged="blocking_changed" Margin="0,3,0,9"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,12,0"><TextBlock Text="Blocking width (inches)"/><TextBox x:Name="BlockWidth" Margin="0,3,0,9"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="Blocking depth (inches)"/><TextBox x:Name="BlockDepth" Margin="0,3,0,9"/></StackPanel>
            </Grid>
            <TextBlock Text="Joists and solid blocking are native Structural Framing instances. Their solid dimensions, endpoints and top elevation are checked during building. A family that does not flex correctly causes the entire rebuild to roll back. Joins are disabled for this baseline." TextWrapping="Wrap" Margin="0,12,0,0"/>
            <TextBlock Text="LVL, LSL, PSL and I-joists can be selected as user-verified engineered/custom framing if their geometry meets the entered dimensions. Rims still use the joist type; specialty rim-board families are deferred." TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#555555"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="3. Hardware">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14">
            <TextBlock Text="Optional connector families" FontSize="16" FontWeight="SemiBold"/>
            <Button Content="Get Simpson hardware from BIM library..." Click="simpson_library" HorizontalAlignment="Left" Padding="12,7" Margin="0,8,0,8"/>
            <TextBlock Text="Load size-matched single/double hangers, then choose types below. Ties and corner brackets are separate choices. Verify fit, coating and fasteners." TextWrapping="Wrap" Margin="0,0,0,10"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,12,0"><TextBlock Text="Single hanger — single member ends"/><ComboBox x:Name="HangerType" Margin="0,3,0,10"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="Double hanger — touching pairs"/><ComboBox x:Name="DoubleHangerType" Margin="0,3,0,10"/></StackPanel>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,12,0"><TextBlock Text="Hurricane ties — beam crossings"/><ComboBox x:Name="HurricaneType" IsEnabled="False" Margin="0,3,0,10"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="Reviewed angle — inside square corners"/><ComboBox x:Name="CornerStrapType" Margin="0,3,0,10"/></StackPanel>
            </Grid>
            <TextBlock Text="Hangers use measured seat and rear mounting faces. Corner L angles mount vertically against both inside rim faces, centered on joist depth. Ambiguous geometry stops the rebuild with diagnostics; verify the first build in Revit." TextWrapping="Wrap" Margin="0,4,0,10"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,12,0"><TextBlock Text="Hanger seat adjustment (inches; + up)" TextWrapping="Wrap"/><TextBox x:Name="HangerOffset" Margin="0,3,0,10"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="Corner center adjustment (inches; + up)" TextWrapping="Wrap"/><TextBox x:Name="CornerOffset" Margin="0,3,0,10"/></StackPanel>
            </Grid>
            <TextBlock Text="Selected corner brackets replace hangers at perimeter corner connections. Hangers on interior single/double joists remain. Hurricane ties are never substituted at rim ends." TextWrapping="Wrap" Margin="0,3,0,8"/>
            <Expander Header="Individual connector nails and quantities" IsExpanded="True" Margin="0,8,0,0"><StackPanel>
              <CheckBox x:Name="HardwareNails" Content="Model individual hand connector nails and include them in takeoff" Margin="0,8,0,8"/>
              <TextBlock Text="Hanger header condition"/><ComboBox x:Name="HangerNailHeader" Margin="0,3,0,8"/>
              <TextBlock Text="H2.5A nail length (inches; published alternatives have different loads)" TextWrapping="Wrap"/><ComboBox x:Name="TieNailLength" Margin="0,3,0,8"/>
              <TextBlock Text="Nail finish / material identifier"/><ComboBox x:Name="HardwareNailFinish" Margin="0,3,0,8"/>
              <TextBlock Text="Recognized LUS, H2.5A and L70/L90 models use separate face, double-shear, joist/beam or angle-leg quantities. CAD holes are used when measurable; other positions use a flagged schematic face pattern. Unknown models receive no guessed nail schedule. Verify finish, penetration and hole alignment; these quantities do not establish connection capacity." TextWrapping="Wrap" Foreground="#555555"/>
            </StackPanel></Expander>
            <Expander Header="Family support and placement details" Margin="0,8,0,0"><StackPanel>
              <TextBlock Text="Single 2x4/6/8/10 and double 2x10 (LUS210-2) are indexed. Two touching 1.5-inch plies form a 3-inch assembly; spaced members use singles. Other sections open Drawing Finder." TextWrapping="Wrap" Margin="0,6,0,6"/>
              <TextBlock Text="Generic Model / Structural Connections point or eligible non-face-hosted work-plane types are supported. Face/wall/floor-hosted and adaptive families need another workflow." TextWrapping="Wrap" Margin="0,0,0,6"/>
              <TextBlock Text="Native family geometry is measured in a temporary, rolled-back probe. Hanger seat tops align with joist bottoms; L-angle outer contact faces align with inside square corners. Final orientation and contact geometry are checked before commit. Other corner types are deferred. H2.5A tabs align to the joist side and beam face, with their transition at beam top. Review the selected native model before accepting placement." TextWrapping="Wrap" Foreground="#555555"/>
            </StackPanel></Expander>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="4. Supports">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14">
            <CheckBox x:Name="BuildSupports" Content="Generate freestanding supports: two drop beams and posts" Click="support_changed" Margin="0,3,0,12"/>
            <Button Content="PA code references and modeled span review..." Click="code_reference" HorizontalAlignment="Left" Padding="10,6" Margin="0,0,0,10"/>
            <TextBlock Text="PA project jurisdiction (enter the township/borough for local criteria)"/><TextBox x:Name="PAJurisdiction" Margin="0,3,0,9"/>
            <TextBlock Text="Pennsylvania UCC / 2021 IRC reference, effective January 1, 2026. Spans and sections remain user inputs. The review reports modeled centerline distances; automatic code table sizing requires verified species, grade, site loads and local criteria." TextWrapping="Wrap" Foreground="#555555" Margin="0,0,0,12"/>
            <TextBlock Text="Beams run perpendicular to joists and directly beneath them. Setbacks follow the joist direction from the near/far footprint edges. Sections, post height and spacing are user inputs; this tool does not size members or design foundations." TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBlock Text="Loaded Structural Framing type — each beam ply"/><ComboBox x:Name="BeamType" SelectionChanged="beam_changed" Margin="0,3,0,9"/>
            <TextBlock Text="Touching lumber plies per beam assembly"/><ComboBox x:Name="BeamPlies" Margin="0,3,0,9"/>
            <TextBlock Text="Maximum beam piece length (feet; butt splices at modeled posts)"/><TextBox x:Name="BeamStock" Margin="0,3,0,9"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,12,0"><TextBlock Text="Actual width of ONE ply (inches)"/><TextBox x:Name="BeamWidth" Margin="0,3,0,9"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="Actual beam depth (inches)"/><TextBox x:Name="BeamDepth" Margin="0,3,0,9"/></StackPanel>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,12,0"><TextBlock Text="Near beam center setback (feet)"/><TextBox x:Name="BeamNearSetback" Margin="0,3,0,9"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="Far beam center setback (feet)"/><TextBox x:Name="BeamFarSetback" Margin="0,3,0,9"/></StackPanel>
            </Grid>
            <TextBlock Text="Loaded two-level Structural Column post family/type"/><ComboBox x:Name="PostType" SelectionChanged="post_changed" Margin="0,3,0,9"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,12,0"><TextBlock Text="Actual post width (inches)"/><TextBox x:Name="PostWidth" Margin="0,3,0,9"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="Actual post depth (inches)"/><TextBox x:Name="PostDepth" Margin="0,3,0,9"/></StackPanel>
            </Grid>
            <TextBlock Text="Post height below beam underside (feet)"/><TextBox x:Name="PostHeight" Margin="0,3,0,9"/>
            <TextBlock Text="Post center setback from each beam end (feet)"/><TextBox x:Name="PostEndSetback" Margin="0,3,0,9"/>
            <TextBlock Text="Maximum post center spacing along each beam (feet)"/><TextBox x:Name="PostSpacing" Margin="0,3,0,9"/>
            <TextBlock Text="Each beam contains two or three separately modeled, touching plies of the selected type. Posts stay centered under each assembly. Verify ply fastening, post/cap bearing, treatment, cantilevers and connections. Post bases/caps, footings and ledger layouts are deferred." TextWrapping="Wrap" Margin="0,10,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="5. Preview &amp; clips">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14">
          <Button Content="Update plan preview and counts" Click="preview" HorizontalAlignment="Left" Padding="10,6" Margin="0,0,0,8"/>
          <Border BorderBrush="#BBBBBB" BorderThickness="1" Background="#FAFAFA" Margin="0,0,0,8"><Canvas x:Name="LayoutCanvas" Height="220" ClipToBounds="True"/></Border>
          <TextBlock x:Name="PreviewLegend" Text="Preview shows planned geometry and insertion points; actual family geometry is checked during building." TextWrapping="Wrap" Margin="0,0,0,12"/>
          <TextBlock Text="Picture-frame / breaker fastening" FontWeight="SemiBold"/><ComboBox x:Name="BorderFastening" Margin="0,3,0,8"/>
          <TextBlock Text="Choose approved grooved/routed long edges with clips, or square-edge boards with schematic face screws. Enable face screws below for flat first/last field edges. Exposed perimeter starter clips and end-grain clips are not added automatically." TextWrapping="Wrap" Margin="0,0,0,8"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0"><TextBlock Text="Supplementary station spacing (inches)" TextWrapping="Wrap"/><TextBox x:Name="BorderFastenerSpacing" Margin="0,3,0,8"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="Border end / face-edge setback (inches)" TextWrapping="Wrap"/><TextBox x:Name="BorderEndSetback" Margin="0,3,0,8"/></StackPanel>
          </Grid>
          <CheckBox x:Name="FieldEdgeFaceScrews" Content="Face screws at flat first / last field-board edges" Margin="0,0,0,8"/>
          <TextBlock Text="Field face screw edge / end setback (inches; verify decking product requirements)" TextWrapping="Wrap"/><TextBox x:Name="FieldFaceSetback" Margin="0,3,0,8"/>
          <TextBlock Text="Border rails share framing stations. Miter/end screws stay at the specified setbacks; touching joist pairs supply one regular station. Missing support can receive clear-bay blocking without shifting the screw pattern." TextWrapping="Wrap" Margin="0,0,0,8"/>
          <CheckBox x:Name="BorderAddBacking" Content="Add missing cross-blocking in clear framing bays" Margin="0,0,0,10"/>
          <TextBlock Text="Counts include supported modeled locations. Missing backing is marked in magenta and excluded; verify product spacing, groove geometry, routed edges and fastener requirements." TextWrapping="Wrap" Margin="0,0,0,12"/>
          <TextBlock Text="Clip representation"/><ComboBox x:Name="ClipMode" SelectionChanged="options_changed" Margin="0,3,0,12"/>
          <TextBlock Text="Loaded unhosted Generic Model family/type"/><ComboBox x:Name="ClipType" Margin="0,3,0,12"/>
          <TextBlock Text="Loaded family origin must be the gap center at board underside. Local X follows board length; local Y crosses the gap; Z points up. Select a type that fits the chosen gap and check its origin and orientation in a test deck." TextWrapping="Wrap" Margin="0,0,0,12"/>
          <Button Content="Create generic schematic clip RFA..." Click="create_clip" HorizontalAlignment="Left" Padding="12,7" Margin="0,0,0,12"/>
          <TextBlock Text="The previous DECKTOOLS generic CAMO-style schematic geometry is reused. It fits 3/16-inch gaps; it is not manufacturer CAD or a certified fastening model." TextWrapping="Wrap" Margin="0,0,0,12"/>
          <TextBlock Text="Field clips and optional border clips are counted together; border clips and schematic face screws also have separate counts. Miters, end grain, outer starter clips and product-specific additional fasteners require review." TextWrapping="Wrap"/>
        </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="2" Margin="0,12,0,8">
      <WrapPanel>
        <CheckBox x:Name="BuildBoards" Content="Generate boards" Click="options_changed" Margin="0,0,20,6"/>
        <CheckBox x:Name="BuildFraming" Content="Generate joists and supports" Click="options_changed" Margin="0,0,20,6"/>
        <CheckBox x:Name="BuildClips" Content="Generate clips / face fasteners" Click="options_changed" Margin="0,0,0,6"/>
      </WrapPanel>
      <TextBlock Text="Unchecking a component removes its previous registered elements on rebuild. Unrelated model elements and source Floors are preserved." TextWrapping="Wrap" Foreground="#555555"/>
      <TextBlock x:Name="CountSummary" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#264653"/>
      <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="80"><TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,7,0,0" Foreground="#444444"/></ScrollViewer>
    </StackPanel>
    <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
      <Button Content="Help" Click="help" Padding="10,7" Margin="0,0,8,0"/>
      <Button Content="Re-pick footprint..." Click="repick" Padding="10,7" Margin="0,0,8,0"/>
      <Button Content="Preview layout" Click="preview" Padding="10,7" Margin="0,0,8,0"/>
      <Button Content="Build / rebuild layout" Click="build" Padding="14,7" Margin="0,0,8,0" FontWeight="SemiBold"/>
      <Button Content="Cancel" Click="cancel" Padding="10,7"/>
    </WrapPanel>
  </Grid>
</Window>
