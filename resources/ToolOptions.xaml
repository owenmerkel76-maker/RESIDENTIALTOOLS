<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="600" Height="680" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock x:Name="Context" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#555555"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Fields"/></ScrollViewer>
    <StackPanel Grid.Row="2" Margin="0,10,0,10">
      <TextBlock x:Name="Summary" TextWrapping="Wrap" Foreground="#264653"/>
      <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="#B22222" Margin="0,5,0,0"/>
    </StackPanel>
    <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
      <Button Content="Check inputs" Click="preview" Padding="12,7" Margin="0,0,8,0"/>
      <Button x:Name="AcceptButton" Content="Continue" Click="accept" Padding="12,7" Margin="0,0,8,0" IsDefault="True"/>
      <Button Content="Cancel" Click="cancel" Padding="12,7" IsCancel="True"/>
    </WrapPanel>
  </Grid>
</Window>
